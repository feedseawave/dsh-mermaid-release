# dsh-mermaid-release local publish config.
# Isolates this release workflow from user-global npm config
# (auth-type=web, registry=https://registry.npmmirror.com) so publishes
# to the local verdaccio never trigger interactive browser auth.
# All official @deepseek-ai packages are proxied by verdaccio (uplink npmjs).
registry=http://localhost:4873/
auth-type=legacy
fetch-retries=5
fetch-retry-mintimeout=1000
fetch-retry-maxtimeout=60000
fetch-timeout=300000
